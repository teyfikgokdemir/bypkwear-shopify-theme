<section class="bypk-hero" style="--bypk-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  <div class="bypk-hero__content">
    {% if section.settings.kicker != blank %}<p class="bypk-kicker bypk-reveal">{{ section.settings.kicker }}</p>{% endif %}
    <h1 class="bypk-title bypk-reveal">{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}<p class="bypk-hero__lead bypk-reveal">{{ section.settings.text }}</p>{% endif %}
    <div class="bypk-hero__actions bypk-reveal">
      {% if section.settings.primary_label != blank %}<a class="bypk-button bypk-button--light" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>{% endif %}
      {% if section.settings.secondary_label != blank %}<a class="bypk-hero__text-link" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }} <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .bypk-hero { position: relative; min-height: min(84svh, 900px); overflow: hidden; color: #fff; background: radial-gradient(circle at 78% 16%, rgba(244,240,232,.22), transparent 23rem), linear-gradient(135deg, #11100e 0%, #11100e 58%, #211d18 58%, #332b24 100%); }
  .bypk-hero::before { content: ""; position: absolute; right: clamp(1rem, 6vw, 7rem); top: clamp(4rem, 10vw, 8rem); width: clamp(150px, 24vw, 360px); aspect-ratio: 1; border: 1px solid rgba(255,255,255,.18); border-radius: 50%; pointer-events: none; }
  .bypk-hero::after { content: ""; position: absolute; right: 0; bottom: 0; width: min(46vw, 680px); height: 46%; background: linear-gradient(135deg, transparent 0%, rgba(244,240,232,.1) 100%); clip-path: polygon(28% 0, 100% 0, 100% 100%, 0 100%); pointer-events: none; }
  .bypk-hero__content { position: relative; z-index: 1; display: flex; min-height: inherit; max-width: 980px; flex-direction: column; justify-content: flex-end; padding: clamp(2.4rem, 6vw, 6rem); padding-bottom: clamp(4rem, 8vw, 8rem); }
  .bypk-hero__lead { max-width: 48ch; margin: 1.25rem 0 0; color: rgba(255,255,255,.86); font-size: clamp(1rem, 1.45vw, 1.26rem); line-height: 1.65; }
  .bypk-hero__actions { display: flex; align-items: center; gap: 1.5rem; margin-top: 2.2rem; }
  .bypk-button--light:hover { color: #111; background: #fff; }
  .bypk-hero__text-link { color: inherit; font-size: .78rem; font-weight: 650; letter-spacing: .1em; text-underline-offset: 5px; }
  @media (max-width: 749px) {
    .bypk-hero { min-height: 76svh; background: linear-gradient(155deg, #11100e 0%, #11100e 66%, #2a241f 66%, #2a241f 100%); }
    .bypk-hero::before { right: -42px; top: 82px; width: 170px; opacity: .6; }
    .bypk-hero::after { width: 78vw; height: 28%; opacity: .7; }
    .bypk-hero__content { justify-content: flex-end; padding: 2rem 1.15rem 3rem; }
    .bypk-title { max-width: 10ch; font-size: clamp(2.6rem, 12vw, 4rem); line-height: .94; }
    .bypk-hero__lead { margin-top: 1rem; font-size: .98rem; line-height: 1.55; }
    .bypk-hero__actions { align-items: stretch; flex-direction: column; width: 100%; gap: .9rem; margin-top: 1.6rem; }
    .bypk-hero__actions .bypk-button { width: 100%; }
    .bypk-hero__text-link { align-self: flex-start; padding-block: .45rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PKWEAR Editoryal Hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Üst başlık", "default": "PKWEAR · YENİ SEZON" },
    { "type": "inline_richtext", "id": "heading", "label": "Başlık", "default": "Şehrin ritmine göre tasarlandı." },
    { "type": "textarea", "id": "text", "label": "Açıklama", "default": "Etek ve eşofman koleksiyonlarında şehir temposuna uyum sağlayan modern, rahat ve güçlü parçaları keşfet." },
    { "type": "text", "id": "primary_label", "label": "Ana buton", "default": "Yeni Gelenleri Keşfet" },
    { "type": "url", "id": "primary_link", "label": "Ana buton bağlantısı" },
    { "type": "text", "id": "secondary_label", "label": "İkinci bağlantı", "default": "Tüm Koleksiyon" },
    { "type": "url", "id": "secondary_link", "label": "İkinci bağlantı" },
    { "type": "range", "id": "overlay_opacity", "label": "Görsel karartma", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 25 }
  ],
  "presets": [{ "name": "PKWEAR Editoryal Hero" }]
}
{% endschema %}
