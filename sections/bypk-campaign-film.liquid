<section class="bypk-film">
  <video class="bypk-film__video" autoplay muted loop playsinline controls controlslist="nodownload noremoteplayback" preload="auto" poster="{{ 'bypkwear-hero-v1.png' | asset_url }}" aria-label="PKWEAR etek ve eşofman koleksiyonu filmi">
    <source src="{{ 'pkwear-campaign-film-web.mp4' | asset_url }}" type="video/mp4">
  </video>
  <div class="bypk-film__shade"></div>
  <div class="bypk-film__content">
    <p class="bypk-kicker">{{ section.settings.kicker }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <a class="bypk-button" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
  </div>
</section>

{% stylesheet %}
  .bypk-film { position: relative; min-height: clamp(520px, 72vw, 820px); overflow: hidden; color: #fff; background: #171513; }
  .bypk-film__video, .bypk-film__shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .bypk-film__video { object-fit: cover; }
  .bypk-film__shade, .bypk-film__content { pointer-events: none; }
  .bypk-film__content .bypk-button { pointer-events: auto; }
  .bypk-film__shade { background: linear-gradient(90deg, rgba(0,0,0,.56), rgba(0,0,0,.08)); }
  .bypk-film__content { position: relative; z-index: 1; display: flex; min-height: inherit; max-width: 680px; flex-direction: column; justify-content: center; align-items: flex-start; padding: clamp(2rem, 7vw, 7rem); }
  .bypk-film__content h2 { max-width: 10ch; margin: 0; font-size: clamp(3rem, 7vw, 7rem); font-weight: 450; letter-spacing: -.055em; line-height: .92; }
  .bypk-film__content > p:not(.bypk-kicker) { max-width: 48ch; margin: 1.5rem 0 2rem; font-size: clamp(.95rem, 1.3vw, 1.12rem); line-height: 1.65; }
  .bypk-film .bypk-button { color: #fff; }
  .bypk-film .bypk-button:hover { color: #111; background: #fff; }
  @media (max-width: 749px) {
    .bypk-film { min-height: 64svh; }
    .bypk-film__video { object-position: 58% center; }
    .bypk-film__shade { background: linear-gradient(0deg, rgba(0,0,0,.72), rgba(0,0,0,.05) 72%); pointer-events: none; }
    .bypk-film__content { justify-content: flex-end; padding: 2rem 1.15rem 4.75rem; pointer-events: none; }
    .bypk-film__content h2 { max-width: 9ch; font-size: clamp(2.6rem, 12vw, 4rem); }
    .bypk-film__content > p:not(.bypk-kicker) { margin: 1rem 0 1.4rem; font-size: .92rem; line-height: 1.5; }
    .bypk-film__content .bypk-button { align-self: flex-start; pointer-events: auto; }
  }
{% endstylesheet %}

{% javascript %}
  const setupCampaignFilm = (root) => {
    const video = root.querySelector('.bypk-film__video');
    if (!video || video.dataset.ready === 'true') return;
    video.dataset.ready = 'true';

    const tryPlay = () => {
      video.muted = true;
      video.playsInline = true;
      return video.play().catch(() => undefined);
    };
    video.addEventListener('canplay', () => {
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && video.paused) tryPlay();
    }, { once: true });
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) tryPlay();
  };

  document.querySelectorAll('.bypk-film').forEach(setupCampaignFilm);
  document.addEventListener('shopify:section:load', (event) => {
    const film = event.target.querySelector('.bypk-film');
    if (film) setupCampaignFilm(film);
  });
{% endjavascript %}

{% schema %}
{
  "name": "PKWEAR Koleksiyon Filmi",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Üst başlık", "default": "PKWEAR · ŞEHİR STİLİ" },
    { "type": "inline_richtext", "id": "heading", "label": "Başlık", "default": "Hareket özgürlükle buluştu." },
    { "type": "textarea", "id": "text", "label": "Metin", "default": "Günün her anına uyum sağlayan etekler ve eşofman takımlarıyla kendi ritmini yakala." },
    { "type": "text", "id": "link_label", "label": "Buton", "default": "Koleksiyonu Keşfet" },
    { "type": "url", "id": "link", "label": "Bağlantı" }
  ],
  "presets": [{ "name": "PKWEAR Koleksiyon Filmi" }]
}
{% endschema %}
