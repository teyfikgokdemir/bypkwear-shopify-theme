<section class="bypk-campaign" aria-labelledby="bypk-campaign-title-{{ section.id }}">
  <div class="bypk-campaign__content">
    <p class="bypk-kicker">{{ section.settings.kicker }}</p>
    <h2 id="bypk-campaign-title-{{ section.id }}">{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <div class="bypk-campaign__actions">
      {% if section.settings.skirt_link != blank %}
        <a class="bypk-button" href="{{ section.settings.skirt_link }}">{{ section.settings.skirt_label }}</a>
      {% endif %}
      {% if section.settings.tracksuit_link != blank %}
        <a class="bypk-button bypk-button--ghost" href="{{ section.settings.tracksuit_link }}">{{ section.settings.tracksuit_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .bypk-campaign { position: relative; display: block; overflow: hidden; padding: clamp(3.5rem, 8vw, 8rem) clamp(1.15rem, 6vw, 6rem); color: #fff; background: radial-gradient(circle at 86% 18%, rgba(244,240,232,.18), transparent 28rem), linear-gradient(135deg, #11100e 0%, #11100e 54%, #1e1a16 54%, #2a241f 100%); }
  .bypk-campaign::after { content: ""; position: absolute; inset: auto clamp(1rem, 5vw, 5rem) clamp(1rem, 4vw, 3rem) auto; width: clamp(120px, 18vw, 260px); aspect-ratio: 1; border: 1px solid rgba(255,255,255,.18); border-radius: 50%; opacity: .7; pointer-events: none; }
  .bypk-campaign__content { position: relative; z-index: 1; display: flex; max-width: 780px; flex-direction: column; align-items: flex-start; }
  .bypk-campaign__content h2 { max-width: 11ch; margin: 0; font-size: clamp(3.4rem, 8vw, 8rem); font-weight: 440; letter-spacing: -.06em; line-height: .9; }
  .bypk-campaign__content > p:not(.bypk-kicker) { max-width: 48ch; margin: 1.45rem 0 2.1rem; color: rgba(255,255,255,.86); font-size: clamp(1rem, 1.35vw, 1.2rem); line-height: 1.65; }
  .bypk-campaign__actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .bypk-campaign .bypk-button { color: #fff; }
  .bypk-campaign .bypk-button:hover { color: #111; background: #fff; }
  .bypk-campaign .bypk-button--ghost { color: #111; background: #fff; }
  .bypk-campaign .bypk-button--ghost:hover { color: #fff; background: transparent; }
  @media (max-width: 749px) {
    .bypk-campaign { padding: 3rem 1rem; background: linear-gradient(155deg, #11100e 0%, #11100e 64%, #2a241f 64%, #2a241f 100%); }
    .bypk-campaign::after { width: 126px; opacity: .45; }
    .bypk-campaign__content h2 { max-width: 9ch; font-size: clamp(3rem, 17vw, 4.8rem); }
    .bypk-campaign__content > p:not(.bypk-kicker) { margin: 1rem 0 1.45rem; font-size: .96rem; line-height: 1.55; }
    .bypk-campaign__actions { width: 100%; flex-direction: column; }
    .bypk-campaign__actions .bypk-button { justify-content: center; width: 100%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PKWEAR Kampanya Bannerı",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Üst başlık", "default": "PKWEAR · ŞEHİR STİLİ" },
    { "type": "inline_richtext", "id": "heading", "label": "Başlık", "default": "Hareket özgürlükle buluştu." },
    { "type": "textarea", "id": "text", "label": "Metin", "default": "Günün her anına uyum sağlayan etekler ve eşofman takımlarıyla kendi ritmini yakala." },
    { "type": "text", "id": "skirt_label", "label": "Etek butonu", "default": "Etekleri Keşfet" },
    { "type": "url", "id": "skirt_link", "label": "Etek bağlantısı", "default": "shopify://collections/etek" },
    { "type": "text", "id": "tracksuit_label", "label": "Eşofman butonu", "default": "Eşofmanları Keşfet" },
    { "type": "url", "id": "tracksuit_link", "label": "Eşofman bağlantısı", "default": "shopify://collections/esofmanlar" }
  ],
  "presets": [{ "name": "PKWEAR Kampanya Bannerı" }]
}
{% endschema %}
