<section class="bypk-campaign" aria-labelledby="bypk-campaign-title-{{ section.id }}">
  <div class="bypk-campaign__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'bypk-campaign__image', loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2400' }}
    {% else %}
      <img
        class="bypk-campaign__image"
        src="{{ 'pkwear-studio-campaign-v1.png' | asset_url }}"
        alt="PKWEAR etek ve eşofman koleksiyonu"
        width="1792"
        height="1024"
        loading="lazy"
      >
    {% endif %}
  </div>
  <div class="bypk-campaign__shade"></div>
  <div class="bypk-campaign__content">
    <p class="bypk-kicker">{{ section.settings.kicker }}</p>
    <h2 id="bypk-campaign-title-{{ section.id }}">{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {% if section.settings.link != blank and section.settings.link_label != blank %}
      <a class="bypk-button" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bypk-campaign { display: grid; grid-template-columns: minmax(360px, 42%) 1fr; min-height: clamp(520px, 48vw, 720px); overflow: hidden; color: #fff; background: #171513; }
  .bypk-campaign__media { grid-column: 2; grid-row: 1; min-width: 0; }
  .bypk-campaign__image { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 68% center; }
  .bypk-campaign__shade { display: none; }
  .bypk-campaign__content { grid-column: 1; grid-row: 1; display: flex; min-height: inherit; max-width: 680px; flex-direction: column; justify-content: center; align-items: flex-start; padding: clamp(2rem, 5vw, 5.5rem); }
  .bypk-campaign__content h2 { max-width: 10ch; margin: 0; font-size: clamp(3rem, 7vw, 7rem); font-weight: 450; letter-spacing: -.055em; line-height: .92; }
  .bypk-campaign__content > p:not(.bypk-kicker) { max-width: 46ch; margin: 1.5rem 0 2rem; font-size: clamp(.95rem, 1.3vw, 1.12rem); line-height: 1.65; }
  .bypk-campaign .bypk-button { color: #fff; }
  .bypk-campaign .bypk-button:hover { color: #111; background: #fff; }
  @media (max-width: 749px) {
    .bypk-campaign { grid-template-columns: 1fr; grid-template-rows: minmax(330px, 58svh) auto; min-height: 0; }
    .bypk-campaign__media { grid-column: 1; grid-row: 1; }
    .bypk-campaign__image { object-position: 64% center; }
    .bypk-campaign__content { grid-column: 1; grid-row: 2; min-height: 0; padding: 2.25rem 1.15rem 2.5rem; }
    .bypk-campaign__content h2 { max-width: 9ch; font-size: clamp(2.6rem, 12vw, 4rem); }
    .bypk-campaign__content > p:not(.bypk-kicker) { margin: 1rem 0 1.4rem; font-size: .92rem; line-height: 1.5; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PKWEAR Kampanya Bannerı",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner görseli" },
    { "type": "text", "id": "kicker", "label": "Üst başlık", "default": "PKWEAR · ŞEHİR STİLİ" },
    { "type": "inline_richtext", "id": "heading", "label": "Başlık", "default": "Hareket özgürlükle buluştu." },
    { "type": "textarea", "id": "text", "label": "Metin", "default": "Günün her anına uyum sağlayan etekler ve eşofman takımlarıyla kendi ritmini yakala." },
    { "type": "text", "id": "link_label", "label": "Buton", "default": "Koleksiyonu Keşfet" },
    { "type": "url", "id": "link", "label": "Bağlantı" }
  ],
  "presets": [{ "name": "PKWEAR Kampanya Bannerı" }]
}
{% endschema %}
